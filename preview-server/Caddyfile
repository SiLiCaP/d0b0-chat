# Front door for test-d0b0.apapss.id.lv. cloudflared sends every request here.
#
#   /_matrix/*, /_synapse/client/*  -> test Synapse (public, the apps log in here)
#   /pr-<N>/                        -> landing page with links and test accounts
#   /pr-<N>/testers.json            -> test account credentials
#   /pr-<N>/web/...                 -> web build of PR <N> (static files)
#   /pr-<N>/api/...                 -> d0b0-helper (one-click login on the emulator)
#   /pr-<N>/...                     -> noVNC of emulator container android-pr-<N>
#
# Everything under /pr-* must sit behind a Cloudflare Access application.
# The Matrix paths must not, or the Android app cannot reach its homeserver.

{
	admin off
	auto_https off
	servers {
		# Requests arrive through cloudflared on a private Docker network; take the
		# real client IP from Cloudflare so Synapse rate-limits per tester, not globally.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	@matrix path /_matrix/* /_synapse/client/*
	handle @matrix {
		reverse_proxy synapse:8008
	}

	# Lets the app find the homeserver from a full user ID like @tester1:test-d0b0.apapss.id.lv.
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver": {"base_url": "https://test-d0b0.apapss.id.lv"}}`
	}

	@bare path_regexp bare ^/pr-(\d+)$
	redir @bare {path}/ 308

	@landing path_regexp landing ^/pr-(\d+)/$
	handle @landing {
		root * /srv/landing
		rewrite * /index.html
		header Cache-Control no-store
		file_server
	}

	@creds path_regexp creds ^/pr-(\d+)/testers\.json$
	handle @creds {
		root * /secrets
		rewrite * /testers.json
		header Cache-Control no-store
		file_server
	}

	@webbare path_regexp webbare ^/pr-(\d+)/web$
	redir @webbare {path}/ 308

	@web path_regexp web ^/pr-(\d+)/web/
	handle @web {
		root * /srv/sites/pr-{re.web.1}/web
		uri strip_prefix /pr-{re.web.1}/web
		try_files {path} /index.html
		file_server
	}

	@api path_regexp api ^/pr-(\d+)/api/
	handle @api {
		reverse_proxy d0b0-helper:8080
	}

	@emu path_regexp emu ^/pr-(\d+)/
	handle @emu {
		uri strip_prefix /pr-{re.emu.1}
		reverse_proxy android-pr-{re.emu.1}:6080
	}

	handle {
		respond "d0b0 chat test server" 404
	}
}
