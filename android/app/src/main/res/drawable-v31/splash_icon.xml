<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the launcher icon's layers with the mark at the
     size the splash marquee starts from (larger than on the launcher). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background"/>
  <foreground android:drawable="@drawable/splash_mark"/>
</adaptive-icon>
